# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/dist/

# Code-signing material must never be committed. Public certificates are safe
# in principle, but keeping all signing inputs outside the repository avoids
# accidental inclusion of private-key bundles and token configuration.
*.pfx
*.p12
*.pvk
*.key
*.cer
*.crt

# Unused source/intermediate catalog renders (optimized JPG assets are committed).
/assets/products/*.png
/assets/products/basmati_rice.jpg
/assets/products/wheat_flour.jpg
/assets/products/toor_dal.jpg
/assets/products/sugar.jpg
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
# Local backend checkout and Docker runtime data
/Eazyerp/
/tmp/
